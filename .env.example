# このファイルを .env にコピーして値を埋めてください（.env は git 管理外です）

# 必須: https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=

# サイト設定
SITE_TITLE=AI・Codex・Claude活用ラボ
SITE_URL=https://your-username.github.io/ai-automation-blog
SITE_DESCRIPTION=Claude CodeとCodexを駆使したAI開発自動化のノウハウを毎日発信

# 任意: 記事末尾に受託CTAを出す場合
CONTACT_URL=https://your-portfolio-link.example.com

# 任意: Google AdSense 承認後に設定 (ca-pub-XXXXXXXXXXXXXXXX)
ADSENSE_CLIENT_ID=

# 任意: X (旧Twitter) 自動告知用。 https://developer.x.com/ で取得
# 無料枠(Free tier)でも投稿(Write)は月500件まで可能
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
